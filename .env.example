# Скопируйте в .env.local. Секрет сгенерируйте командой из docs/development.md.
BETTER_AUTH_URL=http://localhost:100
BETTER_AUTH_SECRET=
DATABASE_URL=postgresql://yeti:yeti_local_dev@127.0.0.1:5434/yeti
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=YETI STREAM <noreply@yeti.local>
# Для внешнего SMTP задаются вместе; локальный Mailpit не требует их.
SMTP_USER=
SMTP_PASSWORD=
# Только за доверенным proxy, который перезаписывает заголовок; см. docs/development.md.
# AUTH_TRUSTED_PROXY_HEADER=x-real-ip

# Google OAuth: оба значения обязательны; только сервер.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
